<resources>
    <attr name="colorOn" format="reference" />
    <attr name="colorOff" format="reference" />

    <style name="AppTheme" parent="BaseTheme" />
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- One light theme is used for both View and embedded Compose screens. -->
    <style name="BaseTheme" parent="Theme.Material3.Light">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="colorPrimary">@color/vian_primary</item>
        <item name="colorPrimaryDark">@color/vian_primary_dark</item>
        <item name="colorAccent">@color/vian_primary_dark</item>
        <item name="colorOnPrimary">@color/vian_on_primary</item>
        <item name="colorPrimaryContainer">@color/vian_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/vian_on_primary_container</item>
        <item name="colorSecondary">@color/vian_primary_dark</item>
        <item name="colorOnSecondary">@color/vian_on_secondary</item>
        <item name="colorSecondaryContainer">@color/vian_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/vian_on_primary_container</item>
        <item name="colorTertiary">@color/vian_primary_light</item>
        <item name="colorOnTertiary">@color/vian_text_primary</item>
        <item name="colorSurface">@color/vian_surface</item>
        <item name="colorOnSurface">@color/vian_text_primary</item>
        <item name="colorSurfaceVariant">@color/vian_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/vian_text_secondary</item>
        <item name="colorSurfaceContainer">@color/vian_surface_variant</item>
        <item name="colorOnBackground">@color/vian_text_primary</item>
        <item name="colorOn">@color/status_connected</item>
        <item name="colorOff">@color/status_error</item>
        <item name="colorOutline">@color/vian_border</item>
        <item name="colorOutlineVariant">@color/vian_outline_variant</item>
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorErrorContainer">@color/status_error_container</item>
        <item name="colorOnErrorContainer">@color/status_on_error_container</item>

        <item name="android:colorBackground">@color/vian_background</item>
        <item name="android:windowBackground">@color/vian_background</item>

        <item name="actionBarStyle">@style/ActionBar.Red</item>
        <item name="actionBarTheme">@style/ActionBarTheme.Red</item>
        <item name="toolbarStyle">@style/Toolbar.Red</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bottom_nav_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/vian_background</item>
        <item name="android:colorBackground">@color/vian_background</item>
    </style>

    <!-- Legacy style name retained because existing manifest entries use it. -->
    <style name="AppThemeRed" parent="BaseTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorOn">@color/status_connected</item>
        <item name="colorOff">@color/status_error</item>
    </style>

    <style name="AppThemeRed.NoActionBar" parent="AppThemeRed">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppDialog" parent="Theme.Material3.Light.Dialog">
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Rocket switch retains its white thumb and uses the Vianshield blue track. -->
    <style name="RocketSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbIcon">@drawable/ic_rocket2</item>
        <item name="thumbIconTint">@color/switch_rocket_thumb_icon_color</item>
        <item name="thumbTint">@color/switch_rocket_thumb_color</item>
        <item name="trackTint">@color/switch_rocket_track_color</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <style name="RocketSwitch.NoIcon" parent="RocketSwitch">
        <item name="thumbIcon">@null</item>
        <item name="trackDecorationTint">?attr/colorOutline</item>
    </style>

    <!-- Blue app bar with white title, navigation and action icons. -->
    <style name="ActionBar.Red" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/colorPrimaryDark</item>
        <item name="backgroundTint">@color/colorPrimaryDark</item>
        <item name="titleTextStyle">@style/ActionBarTitleText</item>
    </style>

    <style name="ActionBarTheme.Red" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorSurface">@color/colorPrimaryDark</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorOnSurfaceVariant">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="colorControlNormal">@android:color/white</item>
    </style>

    <style name="Toolbar.Red" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorPrimaryDark</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">@android:color/white</item>
        <item name="navigationIconTint">@android:color/white</item>
        <item name="materialThemeOverlay">@style/ActionBarTheme.Red</item>
    </style>

    <style name="ActionBarTitleText" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TextLarge" parent="TextAppearance.Material3.HeadlineSmall" />
    <style name="TextMedium" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextSmall" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextTitle" parent="TextAppearance.Material3.TitleLarge" />
</resources>
