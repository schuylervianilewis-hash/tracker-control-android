    <color name="colorRedPrimaryDark">@color/colorPrimaryDark</color>
    <color name="colorRedAccent">@color/colorAccent</color>
    <color name="colorRedOn">@color/colorPrimary</color>
    <color name="colorRedOff">@color/colorAccent</color>

    <color name="colorFooterLink">#0369A1</color>
    <color name="bottom_nav_background">#FFFFFF</color>
    <color name="bottom_nav_active_indicator">#E0F2FE</color>

    <style name="TrackerControlBottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_active_indicator</item>
    </style>
